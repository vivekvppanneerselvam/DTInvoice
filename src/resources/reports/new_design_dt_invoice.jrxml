<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"

        xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd

        http://jasperreports.sourceforge.net/jasperreports/components
        http://jasperreports.sourceforge.net/xsd/components.xsd"

        name="DTThermalInvoice"

        pageWidth="226"
        pageHeight="1200"

        columnWidth="206"

        leftMargin="10"
        rightMargin="10"
        topMargin="5"
        bottomMargin="5"

        whenNoDataType="BlankPage"

        isIgnorePagination="true">
    <property name="com.jaspersoft.studio.unit.pageWidth" value="mm"/>
    <property name="com.jaspersoft.studio.unit.pageHeight" value="mm"/>

    <import value="java.util.*"/>
    <import value="net.sf.jasperreports.engine.*"/>
    <import value="net.sf.jasperreports.engine.data.*"/>

    <!-- ================================================= -->
    <!-- COMPANY PARAMETERS -->
    <!-- ================================================= -->

    <parameter name="firmLogo" class="java.io.InputStream"/>

    <parameter name="firmName" class="java.lang.String"/>

    <parameter name="firmSubName" class="java.lang.String"/>

    <parameter name="firmAddress" class="java.lang.String"/>

    <parameter name="firmPhoneNumbers" class="java.lang.String"/>

    <parameter name="firmEmailAddress" class="java.lang.String"/>

    <parameter name="gstNumber" class="java.lang.String"/>

    <parameter name="fssaiNumber" class="java.lang.String"/>

    <!-- ================================================= -->
    <!-- CUSTOMER -->
    <!-- ================================================= -->

    <parameter name="customerName" class="java.lang.String"/>

    <parameter name="customerPhone" class="java.lang.String"/>

    <parameter name="customerAddress" class="java.lang.String"/>

    <!-- ================================================= -->
    <!-- INVOICE -->
    <!-- ================================================= -->

    <parameter name="invoiceNumber" class="java.lang.String"/>

    <parameter name="invoiceDate" class="java.lang.String"/>

    <parameter name="invoiceTime" class="java.lang.String"/>

    <!-- ================================================= -->
    <!-- PAYMENT -->
    <!-- ================================================= -->

    <parameter name="subTotal" class="java.lang.Double"/>

    <parameter name="gstAmount" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="discount" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="roundOff" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="deliveryCharge" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="billAmount" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="paid" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="balance" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="savedAmount" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="amountInWords" class="java.lang.String"/>

    <parameter name="termsAndConditions" class="java.lang.String"/>

    <!-- ================================================= -->
    <!-- LOYALTY POINTS -->
    <!-- ================================================= -->

    <parameter name="billPoints" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <parameter name="usedPoints" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[0]]></defaultValueExpression>
    </parameter>

    <parameter name="earnedPoints" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[0]]></defaultValueExpression>
    </parameter>

    <parameter name="totalPoints" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[0]]></defaultValueExpression>
    </parameter>

    <parameter name="availablePoints" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <!-- ================================================= -->
    <!-- QR / BARCODE -->
    <!-- ================================================= -->

    <parameter name="qrCodeImage" class="java.io.InputStream"/>

    <parameter name="barcodeValue" class="java.lang.String"/>

    <!-- ================================================= -->
    <!-- DATASET -->
    <!-- ================================================= -->

    <queryString>
        <![CDATA[]]>
    </queryString>

    <field name="itemName" class="java.lang.String"/>

    <field name="qty" class="java.lang.Double"/>

    <field name="unit" class="java.lang.String"/>

    <field name="rate" class="java.lang.Double"/>

    <field name="gst" class="java.lang.Double"/>

    <!-- ================================================= -->
    <!-- VARIABLES -->
    <!-- ================================================= -->

    <variable name="amount" class="java.lang.Double">
        <variableExpression><![CDATA[$F{qty} * $F{rate}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>

    <variable name="amountTotal" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$V{amount}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>

    <variable name="quantityTotal" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{qty}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>

    <background>
        <band splitType="Stretch"/>
    </background>

    <!-- ================================================= -->
    <!-- TITLE -->
    <!-- ================================================= -->
    <title>
        <band height="145" splitType="Stretch">

            <!-- OUTER BORDER -->
            <rectangle>
                <reportElement x="0" y="0" width="206" height="145"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </rectangle>

            <!-- GSTIN (Top Left) -->
            <staticText>
                <reportElement x="5" y="5" width="30" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <text><![CDATA[GSTIN :]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="35" y="5" width="70" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{gstNumber}]]></textFieldExpression>
            </textField>

            <!-- PHONE (Top Right) -->
<!--            <image hAlign="Center" vAlign="Middle">-->
<!--                <reportElement x="155" y="4" width="8" height="8"/>-->
<!--                <imageExpression><![CDATA["phone_icon.png"]]></imageExpression>-->
<!--            </image>-->

            <textField isBlankWhenNull="true">
                <reportElement x="165" y="5" width="36" height="8"/>
                <textElement textAlignment="Right">
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{firmPhoneNumbers}]]></textFieldExpression>
            </textField>

            <!-- COMPANY NAME (Centered) -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="18" width="206" height="16"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{firmName}]]></textFieldExpression>
            </textField>

            <!-- SUB NAME / LOCATION -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="34" width="206" height="10"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{firmSubName}]]></textFieldExpression>
            </textField>

            <!-- SEPARATOR LINE -->
            <line>
                <reportElement x="5" y="50" width="196" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <!-- BILL TITLE -->
            <staticText>
                <reportElement x="0" y="55" width="206" height="12"/>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[BILL]]></text>
            </staticText>

            <!-- SEPARATOR LINE -->
            <line>
                <reportElement x="5" y="70" width="196" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <!-- BILL NO AND DATE ROW -->
            <staticText>
                <reportElement x="5" y="75" width="35" height="8"/>
                <textElement>
                    <font size="6" isBold="true"/>
                </textElement>
                <text><![CDATA[Bill No :]]></text>
            </staticText>

            <textField>
                <reportElement x="40" y="75" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{invoiceNumber}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="110" y="75" width="25" height="8"/>
                <textElement>
                    <font size="6" isBold="true"/>
                </textElement>
                <text><![CDATA[Date :]]></text>
            </staticText>

            <textField>
                <reportElement x="135" y="75" width="66" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{invoiceDate}]]></textFieldExpression>
            </textField>

            <!-- CUSTOMER DETAILS -->
            <staticText>
                <reportElement x="5" y="88" width="60" height="8"/>
                <textElement>
                    <font size="6" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer Details :]]></text>
            </staticText>

            <staticText>
                <reportElement x="110" y="88" width="25" height="8"/>
                <textElement>
                    <font size="6" isBold="true"/>
                </textElement>
                <text><![CDATA[Time :]]></text>
            </staticText>

            <textField>
                <reportElement x="135" y="88" width="66" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{invoiceTime}]]></textFieldExpression>
            </textField>

            <!-- NAME -->
            <staticText>
                <reportElement x="5" y="100" width="30" height="8"/>
                <textElement>
                    <font size="6" isBold="true"/>
                </textElement>
                <text><![CDATA[Name :]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="40" y="100" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression>
            </textField>

            <!-- ADDRESS -->
            <staticText>
                <reportElement x="5" y="112" width="35" height="8"/>
                <textElement>
                    <font size="6" isBold="true"/>
                </textElement>
                <text><![CDATA[Address :]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="40" y="112" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerAddress}]]></textFieldExpression>
            </textField>

            <!-- CONTACT -->
            <staticText>
                <reportElement x="5" y="124" width="35" height="8"/>
                <textElement>
                    <font size="6" isBold="true"/>
                </textElement>
                <text><![CDATA[Contact :]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="40" y="124" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerPhone}]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <!-- ================================================= -->
    <!-- COLUMN HEADER -->
    <!-- ================================================= -->

    <columnHeader>
        <band height="16">

            <rectangle>
                <reportElement x="0" y="0" width="206" height="16"/>
                <graphicElement>
                    <pen lineWidth="0.8"/>
                </graphicElement>
            </rectangle>

            <line>
                <reportElement x="20" y="0" width="1" height="16"/>
            </line>

            <line>
                <reportElement x="110" y="0" width="1" height="16"/>
            </line>

            <line>
                <reportElement x="145" y="0" width="1" height="16"/>
            </line>

            <line>
                <reportElement x="175" y="0" width="1" height="16"/>
            </line>

            <!-- SR -->
            <staticText>
                <reportElement x="0" y="3" width="20" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Sr.]]></text>
            </staticText>

            <!-- PRODUCT -->
            <staticText>
                <reportElement x="22" y="3" width="86" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Product]]></text>
            </staticText>

            <!-- QTY -->
            <staticText>
                <reportElement x="112" y="3" width="32" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>

            <!-- RATE -->
            <staticText>
                <reportElement x="147" y="3" width="26" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Rate]]></text>
            </staticText>

            <!-- AMOUNT -->
            <staticText>
                <reportElement x="177" y="3" width="27" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Amount]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ================================================= -->
    <!-- DETAIL -->
    <!-- ================================================= -->

    <detail>
        <band height="22" splitType="Stretch">

            <rectangle>
                <reportElement x="0" y="0" width="206" height="22"/>
            </rectangle>

            <line>
                <reportElement x="20" y="0" width="1" height="22"/>
            </line>

            <line>
                <reportElement x="110" y="0" width="1" height="22"/>
            </line>

            <line>
                <reportElement x="145" y="0" width="1" height="22"/>
            </line>

            <line>
                <reportElement x="175" y="0" width="1" height="22"/>
            </line>

            <!-- SERIAL -->
            <textField>
                <reportElement x="0" y="2" width="20" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <!-- ITEM NAME -->
            <textField textAdjust="StretchHeight">
                <reportElement x="22" y="2" width="86" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemName}]]></textFieldExpression>
            </textField>

            <!-- QTY with UNIT -->
            <textField>
                <reportElement x="112" y="2" width="32" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.3f", $F{qty})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="112" y="12" width="32" height="8"/>
                <textElement textAlignment="Center">
                    <font size="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{unit}]]></textFieldExpression>
            </textField>

            <!-- RATE -->
            <textField>
                <reportElement x="147" y="2" width="26" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $F{rate})]]></textFieldExpression>
            </textField>

            <!-- AMOUNT -->
            <textField>
                <reportElement x="177" y="2" width="27" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $V{amount})]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ================================================= -->
    <!-- SUMMARY -->
    <!-- ================================================= -->

    <summary>
        <band height="280" splitType="Stretch">

            <!-- TOTAL ROW -->
            <rectangle>
                <reportElement x="0" y="0" width="206" height="16"/>
            </rectangle>

            <line>
                <reportElement x="110" y="0" width="1" height="16"/>
            </line>

            <line>
                <reportElement x="175" y="0" width="1" height="16"/>
            </line>

            <staticText>
                <reportElement x="112" y="3" width="32" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Total :]]></text>
            </staticText>

            <textField>
                <reportElement x="177" y="3" width="27" height="10"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $V{amountTotal})]]></textFieldExpression>
            </textField>

            <!-- YOU SAVED SECTION (Left) + SUMMARY (Right) -->
            <rectangle>
                <reportElement x="0" y="20" width="100" height="50"/>
            </rectangle>

            <staticText>
                <reportElement x="5" y="25" width="90" height="12"/>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[YOU]]></text>
            </staticText>

            <staticText>
                <reportElement x="5" y="37" width="90" height="12"/>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[SAVED]]></text>
            </staticText>

            <textField>
                <reportElement x="5" y="52" width="90" height="14"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["₹ " + String.format("%.2f", $P{savedAmount})]]></textFieldExpression>
            </textField>

            <!-- SUMMARY BOX (Right) -->
            <rectangle>
                <reportElement x="100" y="20" width="106" height="50"/>
            </rectangle>

            <staticText>
                <reportElement x="105" y="24" width="50" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <text><![CDATA[Bill Discount]]></text>
            </staticText>

            <textField>
                <reportElement x="160" y="24" width="42" height="8"/>
                <textElement textAlignment="Right">
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $P{discount})]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="105" y="36" width="50" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <text><![CDATA[Round Off]]></text>
            </staticText>

            <textField>
                <reportElement x="160" y="36" width="42" height="8"/>
                <textElement textAlignment="Right">
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $P{roundOff})]]></textFieldExpression>
            </textField>

            <!-- NET TOTAL ROW -->
            <rectangle>
                <reportElement x="100" y="48" width="106" height="14" mode="Opaque" backcolor="#FFFFFF"/>
            </rectangle>

            <staticText>
                <reportElement x="105" y="50" width="50" height="10"/>
                <textElement>
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Net Total]]></text>
            </staticText>

            <textField>
                <reportElement x="155" y="50" width="47" height="10"/>
                <textElement textAlignment="Right">
                    <font size="7" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $P{billAmount})]]></textFieldExpression>
            </textField>

            <!-- AMOUNT IN WORDS -->
            <rectangle>
                <reportElement x="0" y="74" width="206" height="22"/>
            </rectangle>

            <textField textAdjust="StretchHeight">
                <reportElement x="5" y="78" width="196" height="14"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA["Amount in words : " + $P{amountInWords}]]></textFieldExpression>
            </textField>

            <!-- TERMS AND CONDITIONS -->
            <rectangle>
                <reportElement x="0" y="100" width="206" height="20"/>
            </rectangle>

            <staticText>
                <reportElement x="5" y="104" width="80" height="8"/>
                <textElement>
                    <font size="6" isBold="true"/>
                </textElement>
                <text><![CDATA[Terms & Conditions]]></text>
            </staticText>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="5" y="112" width="196" height="6"/>
                <textElement>
                    <font size="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{termsAndConditions}]]></textFieldExpression>
            </textField>

            <!-- BARCODE SECTION -->
            <rectangle>
                <reportElement x="0" y="124" width="206" height="50"/>
            </rectangle>

            <textField>
                <reportElement x="20" y="140" width="166" height="12"/>

                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>

                <textFieldExpression><![CDATA[
        $P{barcodeValue} == null
            ? $P{invoiceNumber}
            : $P{barcodeValue}
    ]]></textFieldExpression>
            </textField>

            <!-- THANK YOU MESSAGE -->
            <staticText>
                <reportElement x="0" y="178" width="206" height="12"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Thank You.. Visit Again !]]></text>
            </staticText>

            <!-- QR CODE AND POINTS SECTION -->
            <rectangle>
                <reportElement x="0" y="194" width="80" height="80"/>
            </rectangle>

            <image hAlign="Center" vAlign="Middle">
                <reportElement x="8" y="202" width="64" height="64" isRemoveLineWhenBlank="true"/>
                <imageExpression><![CDATA[$P{qrCodeImage}]]></imageExpression>
            </image>

            <!-- POINTS TABLE -->
            <rectangle>
                <reportElement x="84" y="194" width="122" height="16"/>
            </rectangle>
            <staticText>
                <reportElement x="88" y="198" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <text><![CDATA[Bill Points]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="198" width="42" height="8"/>
                <textElement textAlignment="Right">
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $P{billPoints})]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="84" y="210" width="122" height="16"/>
            </rectangle>
            <staticText>
                <reportElement x="88" y="214" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <text><![CDATA[Used Points]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="214" width="42" height="8"/>
                <textElement textAlignment="Right">
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{usedPoints}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="84" y="226" width="122" height="16"/>
            </rectangle>
            <staticText>
                <reportElement x="88" y="230" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <text><![CDATA[Earned Points]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="230" width="42" height="8"/>
                <textElement textAlignment="Right">
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{earnedPoints}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="84" y="242" width="122" height="16"/>
            </rectangle>
            <staticText>
                <reportElement x="88" y="246" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <text><![CDATA[Total Points]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="246" width="42" height="8"/>
                <textElement textAlignment="Right">
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalPoints}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="84" y="258" width="122" height="16"/>
            </rectangle>
            <staticText>
                <reportElement x="88" y="262" width="60" height="8"/>
                <textElement>
                    <font size="6"/>
                </textElement>
                <text><![CDATA[Available Points]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="262" width="42" height="8"/>
                <textElement textAlignment="Right">
                    <font size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $P{availablePoints})]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
