<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DTProfessionalInvoice" pageWidth="226" pageHeight="350" whenNoDataType="BlankPage" columnWidth="206" leftMargin="10" rightMargin="10" topMargin="5" bottomMargin="5" isFloatColumnFooter="true" isIgnorePagination="true">
	<property name="com.jaspersoft.studio.unit.pageHeight" value="mm"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="mm"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<!-- Parameters -->
	<parameter name="firmEmailAddress"
	           class="java.lang.String"/>
	<parameter name="invoiceNumber" class="java.lang.String"/>
	<parameter name="invoiceDate" class="java.lang.String"/>
	<parameter name="invoiceTime" class="java.lang.String"/>

	<parameter name="firmSubName" class="java.lang.String"/>

	<parameter name="gstNumber" class="java.lang.String"/>
	<parameter name="fssaiNumber" class="java.lang.String"/>


	<parameter name="qrCodeImage" class="java.io.InputStream"/>

	<parameter name="subTotal" class="java.lang.Double"/>
	<parameter name="amount" class="java.lang.Double"/>
	<parameter name="amountTotal" class="java.lang.Double"/>


<parameter name="customerName" class="java.lang.String" />
	<parameter name="customerPhone" class="java.lang.String" />
	<parameter name="customerAddress" class="java.lang.String" />
	<parameter name="firmName" class="java.lang.String" />
	<parameter name="firmAddress" class="java.lang.String"/>
	<parameter name="firmPhoneNumbers" class="java.lang.String" />
	<parameter name="firmLogo" class="java.io.InputStream"/>
	<parameter name="gstPercent" class="java.math.BigDecimal" >
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<parameter name="gstAmount" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<parameter name="discount" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<parameter name="deliveryCharge" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<parameter name="paid" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<parameter name="balance" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<parameter name="billAmount" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[]]>
	</queryString>
	<field name="itemName" class="java.lang.String">
		<fieldDescription><![CDATA[itemName]]></fieldDescription>
	</field>
	<field name="qty" class="java.lang.Double">
		<fieldDescription><![CDATA[qty]]></fieldDescription>
	</field>
	<field name="gst" class="java.lang.Double">
		<fieldDescription><![CDATA[gst]]></fieldDescription>
	</field>
	<field name="rate" class="java.lang.Double">
		<fieldDescription><![CDATA[rate]]></fieldDescription>
	</field>
	<variable name="amount" class="java.lang.Double">
		<variableExpression><![CDATA[
$F{qty} * $F{rate}
]]></variableExpression>

		<initialValueExpression><![CDATA[
0.0
]]></initialValueExpression>
	</variable>
	<variable name="amountTotal" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$V{amount}]]></variableExpression>
		<initialValueExpression><![CDATA[0.0]]></initialValueExpression>
	</variable>
	<variable name="quantityTotal" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
		<initialValueExpression><![CDATA[0.0]]></initialValueExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="135" splitType="Stretch">
			<!-- HEADER BORDER -->
			<rectangle>
				<reportElement x="0" y="0"
				               width="206"
				               height="135"/>
				<graphicElement>
					<pen lineWidth="1.5"/>
				</graphicElement>
			</rectangle>
			<!-- Logo -->
			<image hAlign="Center" vAlign="Top">
				<reportElement x="4" y="4" width="16" height="16" isRemoveLineWhenBlank="true"/>
				<imageExpression><![CDATA[
$P{firmLogo}
]]></imageExpression>
			</image>
			<!-- Company Name -->
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="22" y="4" width="176" height="9"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{firmName} != null ? $P{firmName}.trim().toUpperCase() : ""]]></textFieldExpression>
			</textField>
			<!-- Subtitle -->
			<textField isBlankWhenNull="true">

				<reportElement
						x="22"
						y="16"
						width="176"
						height="10"/>

				<textElement textAlignment="Center">
					<font size="6" isBold="true"/>
				</textElement>

				<textFieldExpression><![CDATA[
$P{firmSubName}
]]></textFieldExpression>

			</textField>
			<!-- Address -->
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement
						x="22"
						y="28"
						width="176"
						height="7"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{firmAddress} != null ? $P{firmAddress}.trim() : ""]]></textFieldExpression>
			</textField>
			<!-- Phone -->
			<textField isBlankWhenNull="true">
				<reportElement
						x="22"
						y="37"
						width="176"
						height="6"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{firmPhoneNumbers} == null || $P{firmPhoneNumbers}.isEmpty()) ? "" : $P{firmPhoneNumbers}.trim()]]></textFieldExpression>
			</textField>
			<!-- Separator Line -->
			<textField isBlankWhenNull="true">
				<reportElement
						x="22"
						y="45"
						width="176"
						height="6"/>

				<textElement textAlignment="Center">
					<font fontName="Arial" size="5"/>
				</textElement>

				<textFieldExpression><![CDATA[
($P{firmEmailAddress} == null
|| $P{firmEmailAddress}.isEmpty())
? ""
: $P{firmEmailAddress}
]]></textFieldExpression>

			</textField>
			<line>
				<reportElement x="2" y="50" width="202" height="1"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</line>
			<!-- GST/FSSAI Row -->
			<rectangle>
				<reportElement
						x="2"
						y="46"
						width="154"
						height="18"/>
			</rectangle>
			<textField>
				<reportElement x="6" y="50" width="145" height="10"/>
				<textElement>
					<font size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[
"GSTIN: " + ($P{gstNumber} == null ? "" : $P{gstNumber})
+ "    |    FSSAI: "
+ ($P{fssaiNumber} == null ? "" : $P{fssaiNumber})
]]></textFieldExpression>
			</textField>

			<!-- CASH INVOICE BOX -->
			<rectangle>
				<reportElement
						x="156"
						y="46"
						width="48"
						height="18"
						mode="Opaque"
						backcolor="#000000"/>
			</rectangle>
			<textField>
				<reportElement x="154" y="58" width="50" height="12" forecolor="#FFFFFF"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["CASH"]]></textFieldExpression>
			</textField>
			<!-- Separator Line 2 -->
			<line>
				<reportElement x="2" y="77" width="202" height="1"/>
			</line>

			<!-- CUSTOMER DETAILS BOX -->
			<rectangle>
				<reportElement
						x="2"
						y="79"
						width="202"
						height="45"/>
				<graphicElement>
					<pen lineWidth="0.8"/>
				</graphicElement>
			</rectangle>
			<!-- Vertical Divider -->
			<line>
				<reportElement
						x="101"
						y="79"
						width="1"
						height="45"/>
				<graphicElement>
					<pen lineWidth="0.8"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="4"
				               y="82"
				               width="80"
				               height="8"/>
				<textElement>
					<font size="6" isBold="true"/>
				</textElement>
				<text><![CDATA[CUSTOMER DETAILS]]></text>
			</staticText>
			<!-- Customer Info Left -->
			<textField>
				<reportElement x="4" y="91" width="95" height="6"/>
				<textElement>
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[
"Name: " +
(
($P{customerName} != null
&& !$P{customerName}.trim().isEmpty())
?
$P{customerName}
:
"Cash Customer"
)
]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="4" y="99" width="95" height="6"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{customerPhone} != null
&& !$P{customerPhone}.trim().isEmpty())
?
"Ph: " + $P{customerPhone}
:
""]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement x="4"
				               y="107"
				               width="95"
				               height="12"/>
				<textElement verticalAlignment="Top">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[
($P{customerAddress} != null
&& !$P{customerAddress}.trim().isEmpty())
?
"Address: " + $P{customerAddress}
:
""
]]></textFieldExpression>
			</textField>
			<!-- Invoice Info Right -->
			<textField>
				<reportElement x="104" y="88" width="95" height="6"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA["Inv#: " +
($P{invoiceNumber} != null
? $P{invoiceNumber}
: "")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="104" y="96" width="95" height="6"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[
"Date: " + $P{invoiceDate}
]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="104" y="104" width="95" height="6"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA["Time: " + ($P{invoiceTime} != null ? $P{invoiceTime} : "")]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="11" splitType="Stretch">
			<rectangle>
				<reportElement x="0" y="0" width="206" height="11" mode="Opaque" backcolor="#E0E0E0"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</rectangle>
			<textField>
				<reportElement x="2" y="1" width="10" height="9"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["#"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="13" y="0" width="1" height="11"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement x="15" y="1" width="97" height="9"/>
				<textElement>
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ITEM"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="113" y="0" width="1" height="11"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement x="115" y="1" width="30" height="9"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["QTY"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="146" y="0" width="1" height="11"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement x="148" y="1" width="25" height="9"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["GST%"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="174" y="0" width="1" height="11"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement x="176" y="1" width="28" height="9"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["TOTAL"]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="10" splitType="Stretch">
			<rectangle>
				<reportElement x="0" y="0" width="206" height="10"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</rectangle>
			<line>
				<reportElement x="13" y="0" width="1" height="10"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>
			<line>
				<reportElement x="113" y="0" width="1" height="10"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>
			<line>
				<reportElement x="146" y="0" width="1" height="10"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>
			<line>
				<reportElement x="174" y="0" width="1" height="10"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement x="2" y="1" width="10" height="8"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement x="15" y="1" width="97" height="8"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{itemName}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="115" y="1" width="30" height="8"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="148" y="1" width="25" height="8"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{gst}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="176" y="1" width="28" height="8"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[
String.format("%.2f",
$F{qty} * $F{rate})
]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="170" splitType="Stretch">
			<!-- TOTALS ROW -->
			<rectangle>
				<reportElement x="0" y="0" width="206" height="9"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</rectangle>
			<textField>
				<reportElement x="2" y="1" width="70" height="7"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["TOTAL ITEMS: " + $V{REPORT_COUNT}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="74" y="0" width="1" height="9"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement x="76" y="1" width="128" height="7"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["TOTAL QTY: " + $V{quantityTotal}]]></textFieldExpression>
			</textField>
			<!-- QR CODE LEFT SIDE PLACEHOLDER -->
			<rectangle>
				<reportElement
						x="94"
						y="11"
						width="112"
						height="85"/>
			</rectangle>
			<image hAlign="Center"
			       vAlign="Middle">

				<reportElement
						x="12"
						y="16"
						width="72"
						height="72"
						isRemoveLineWhenBlank="true">

					<printWhenExpression><![CDATA[
$P{qrCodeImage} != null
]]></printWhenExpression>

				</reportElement>

				<imageExpression><![CDATA[
$P{qrCodeImage}
]]></imageExpression>

			</image>
			<textField>
				<reportElement x="2"
				               y="68"
				               width="82"
				               height="10"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Thank You"]]></textFieldExpression>
			</textField>
			<!-- PAYMENT SUMMARY TABLE RIGHT SIDE -->
			<rectangle>
				<reportElement x="94" y="11" width="112" height="85"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</rectangle>

			<!-- CENTER VERTICAL SEPARATOR -->
			<line>
				<reportElement x="150" y="11" width="1" height="85"/>
				<graphicElement>
					<pen lineWidth="0.7"/>
				</graphicElement>
			</line>

			<!-- ROW SEPARATORS -->
			<line>
				<reportElement x="94" y="20" width="112" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>

			<line>
				<reportElement x="94" y="29" width="112" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>

			<line>
				<reportElement x="94" y="38" width="112" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>

			<line>
				<reportElement x="94" y="46" width="112" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>

			<line>
				<reportElement x="94" y="54" width="112" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>

			<line>
				<reportElement x="94" y="66" width="112" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>

			<line>
				<reportElement x="94" y="74" width="112" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</line>

			<!-- SUB TOTAL -->
			<textField>
				<reportElement x="98" y="12" width="48" height="7"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA["Sub Total"]]></textFieldExpression>
			</textField>

			<textField>
				<reportElement x="154" y="12" width="48" height="7"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[
String.format("₹ %.2f", $P{subTotal})
]]></textFieldExpression>
			</textField>

			<!-- GST -->
			<textField>
				<reportElement x="98" y="21" width="48" height="7"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA["GST Amount"]]></textFieldExpression>
			</textField>

			<textField>
				<reportElement x="154" y="21" width="48" height="7"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[
($P{gstAmount} != null ? $P{gstAmount} : 0.0)
]]></textFieldExpression>
			</textField>

			<!-- BILL AMOUNT -->
			<textField>
				<reportElement x="98" y="30" width="48" height="7"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA["Bill Amount"]]></textFieldExpression>
			</textField>

			<textField>
				<reportElement x="154" y="30"
				               width="48"
				               height="7"/>

				<textElement textAlignment="Right">
					<font fontName="Arial"
					      size="5"/>
				</textElement>

				<textFieldExpression><![CDATA[
($P{billAmount} != null
? $P{billAmount}
: 0.0)
]]></textFieldExpression>
			</textField>

			<!-- DISCOUNT -->
			<textField>
				<reportElement x="98" y="39" width="48" height="7"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA["Discount"]]></textFieldExpression>
			</textField>

			<textField>
				<reportElement x="154" y="39" width="48" height="7"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA[
($P{discount} != null ? $P{discount} : 0.0)
]]></textFieldExpression>
			</textField>

			<!-- DELIVERY -->
			<textField>
				<reportElement x="98" y="47" width="48" height="7"/>
				<textElement>
					<font fontName="Arial" size="5"/>
				</textElement>
				<textFieldExpression><![CDATA["Delivery Charge"]]></textFieldExpression>
