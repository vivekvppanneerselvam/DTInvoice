                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["₹ " + com.dt.utils.IndianCurrencyFormatting.applyFormatting(java.math.BigDecimal.valueOf($V{amountTotal}))]]></textFieldExpression>
