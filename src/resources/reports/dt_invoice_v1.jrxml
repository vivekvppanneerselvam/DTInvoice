                </textElement>
                <textFieldExpression><![CDATA["₹ " + com.dt.utils.IndianCurrencyFormatting.applyFormatting(($P{deliveryCharge} != null ? $P{deliveryCharge} : BigDecimal.ZERO))]]></textFieldExpression>
            </textField>
            <!-- NET PAYABLE BLACK BOX -->
            <rectangle>
                <reportElement x="103" y="54" width="103" height="12" backcolor="#000000"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </rectangle>
            <textField>
