                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["₹ " + com.dt.utils.IndianCurrencyFormatting.applyFormatting(($P{gstAmount} != null ? $P{gstAmount} : BigDecimal.ZERO))]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="106" y="29" width="50" height="7"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Bill Amount"]]></textFieldExpression>
