            <textField>
                <reportElement x="157" y="29" width="43" height="7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["₹ " + com.dt.utils.IndianCurrencyFormatting.applyFormatting(($P{billAmount} != null ? $P{billAmount} : java.math.BigDecimal.valueOf($V{amountTotal})))]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="106" y="37" width="50" height="7" isRemoveLineWhenBlank="true">
                    <printWhenExpression><![CDATA[$P{discount} != null && $P{discount}.signum() > 0]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Discount"]]></textFieldExpression>
