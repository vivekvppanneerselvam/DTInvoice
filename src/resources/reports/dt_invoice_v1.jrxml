                </textElement>
                <textFieldExpression><![CDATA["Pending Amount"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="157" y="76" width="43" height="7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["₹ " + com.dt.utils.IndianCurrencyFormatting.applyFormatting($P{balance})]]></textFieldExpression>
            </textField>
            <!-- QR CODE SECTION LEFT -->
            <image hAlign="Center" vAlign="Middle">
                <reportElement x="5" y="11" width="50" height="50" isRemoveLineWhenBlank="true"/>
                <imageExpression><![CDATA[$P{qrCodeImage}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="5" y="63" width="50" height="8"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Thank You...\nVisit Again !"]]></textFieldExpression>
            </textField>
            <!-- TERMS & CONDITIONS RIGHT -->
            <rectangle>
                <reportElement x="58" y="11" width="41" height="95"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="58" y="11" width="41" height="10" backcolor="#000000"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="58" y="11" width="41" height="10" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle" >
                    <font fontName="SansSerif" size="5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["TERMS &\nCONDITIONS"]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="60" y="23" width="37" height="80"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="SansSerif" size="4"/>
                </textElement>
                <textFieldExpression><![CDATA["1.Goods once sold not be taken after a week.\n\n2.Refund or exchange policy only permits allows within a week with valid invoice bill.\n\n*** THANK YOU ***"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>

