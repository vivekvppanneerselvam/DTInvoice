<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DTProfessionalInvoice" pageWidth="226" pageHeight="1200" whenNoDataType="BlankPage" columnWidth="206" leftMargin="10" rightMargin="10" topMargin="5" bottomMargin="5" isFloatColumnFooter="true" isIgnorePagination="true">
    <property name="com.jaspersoft.studio.unit.pageHeight" value="mm"/>
    <property name="com.jaspersoft.studio.unit.pageWidth" value="mm"/>
    <import value="net.sf.jasperreports.engine.*"/>
    <import value="java.util.*"/>
    <import value="net.sf.jasperreports.engine.data.*"/>
    <!-- Parameters -->
    <parameter name="invoiceNumber" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="invoiceDate" class="java.time.LocalDate" isForPrompting="false"/>
    <parameter name="invoiceTime" class="java.lang.String" isForPrompting="false"/>
    <parameter name="customerName" class="java.lang.String" isForPrompting="false"/>
    <parameter name="customerPhone" class="java.lang.String" isForPrompting="false"/>
    <parameter name="customerAddress" class="java.lang.String" isForPrompting="false"/>
    <parameter name="firmName" class="java.lang.String" isForPrompting="false"/>
    <parameter name="firmAddress" class="java.lang.String" isForPrompting="false"/>
    <parameter name="firmPhoneNumbers" class="java.lang.String" isForPrompting="false"/>
    <parameter name="firmLogo" class="java.io.InputStream" isForPrompting="false"/>
    <parameter name="gstPercent" class="java.math.BigDecimal" isForPrompting="false">
        <defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
    </parameter>
    <parameter name="gstAmount" class="java.math.BigDecimal" isForPrompting="false">
        <defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
    </parameter>
    <parameter name="discount" class="java.math.BigDecimal" isForPrompting="false">
        <defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
    </parameter>
    <parameter name="deliveryCharge" class="java.math.BigDecimal" isForPrompting="false">
        <defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
    </parameter>
    <parameter name="paid" class="java.math.BigDecimal" isForPrompting="false">
        <defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
    </parameter>
    <parameter name="balance" class="java.math.BigDecimal" isForPrompting="false">
        <defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
    </parameter>
    <parameter name="billAmount" class="java.math.BigDecimal" isForPrompting="false">
        <defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
    </parameter>
    <parameter name="bankDetails" class="java.lang.String" isForPrompting="false"/>
    <parameter name="fssaiNumber" class="java.lang.String" isForPrompting="false"/>
    <parameter name="qrCodeImage" class="java.io.InputStream" isForPrompting="false"/>
    <queryString>
        <![CDATA[]]>
    </queryString>
    <field name="itemName" class="java.lang.String">
        <fieldDescription><![CDATA[itemName]]></fieldDescription>
    </field>
    <field name="qty" class="java.lang.Double">
        <fieldDescription><![CDATA[qty]]></fieldDescription>
    </field>
    <field name="gst" class="java.lang.Double">
        <fieldDescription><![CDATA[gst]]></fieldDescription>
    </field>
    <field name="rate" class="java.lang.Double">
        <fieldDescription><![CDATA[rate]]></fieldDescription>
    </field>
    <variable name="amount" class="java.lang.Double">
        <variableExpression><![CDATA[$F{qty} * $F{rate}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>
    <variable name="amountTotal" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$V{amount}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>
    <variable name="quantityTotal" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{qty}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>
    <background>
        <band splitType="Stretch"/>
    </background>
    <title>
        <band height="95" splitType="Stretch">
            <!-- HEADER BORDER -->
            <rectangle>
                <reportElement x="0" y="0" width="206" height="95"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </rectangle>
            <!-- Logo -->
            <image hAlign="Center" vAlign="Top">
                <reportElement x="4" y="3" width="25" height="25" isRemoveLineWhenBlank="true"/>
                <imageExpression><![CDATA[$P{firmLogo}]]></imageExpression>
            </image>
            <!-- Company Name -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="32" y="3" width="170" height="10"/>
                <textElement textAlignment="Center" verticalAlignment="Top">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{firmName} != null ? $P{firmName}.trim().toUpperCase() : ""]]></textFieldExpression>
            </textField>
            <!-- Subtitle -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="32" y="13" width="170" height="6"/>
                <textElement textAlignment="Center" verticalAlignment="Top">
                    <font fontName="SansSerif" size="6" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["WHOLESALE SPICES MERCHANT"]]></textFieldExpression>
            </textField>
            <!-- Address -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="32" y="19" width="170" height="7"/>
                <textElement textAlignment="Center" verticalAlignment="Top">
                    <font fontName="SansSerif" size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{firmAddress} != null ? $P{firmAddress}.trim() : ""]]></textFieldExpression>
            </textField>
            <!-- Phone -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="32" y="26" width="170" height="6"/>
                <textElement textAlignment="Center" verticalAlignment="Top">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{firmPhoneNumbers} == null || $P{firmPhoneNumbers}.isEmpty()) ? "" : $P{firmPhoneNumbers}.trim()]]></textFieldExpression>
            </textField>
            <!-- Separator -->
            <line>
                <reportElement x="2" y="33" width="202" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>
            <!-- GST/FSSAI Box -->
            <rectangle>
                <reportElement x="2" y="35" width="154" height="14"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="4" y="36" width="30" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["GST:"]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="36" y="36" width="116" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA[(($P{bankDetails} != null && !$P{bankDetails}.isEmpty()) ? $P{bankDetails} : "33ABCDE1234F125")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="4" y="43" width="30" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["FSSAI:"]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="36" y="43" width="116" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA[(($P{fssaiNumber} != null && !$P{fssaiNumber}.isEmpty()) ? $P{fssaiNumber} : "12415023001234")]]></textFieldExpression>
            </textField>
            <!-- CASH INVOICE Black Box -->
            <rectangle>
                <reportElement x="158" y="35" width="46" height="24" backcolor="#000000"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="158" y="35" width="46" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true" />
                </textElement>
                <textFieldExpression><![CDATA["CASH\nINVOICE"]]></textFieldExpression>
            </textField>
            <!-- Separator -->
            <line>
                <reportElement x="2" y="60" width="202" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>
            <!-- CUSTOMER DETAILS SECTION -->
            <textField>
                <reportElement x="4" y="62" width="95" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Name: " + ($P{customerName} == null ? "Cash Sale" : $P{customerName})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="4" y="68" width="95" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Ph: " + (($P{customerPhone} != null && !$P{customerPhone}.isEmpty()) ? $P{customerPhone} : "")]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="4" y="74" width="95" height="18"/>
                <textElement verticalAlignment="Top">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Address: " + (($P{customerAddress} != null && !$P{customerAddress}.isEmpty()) ? $P{customerAddress} : "")]]></textFieldExpression>
            </textField>
            <!-- VERTICAL SEPARATOR -->
            <line>
                <reportElement x="102" y="61" width="1" height="31"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>
            <!-- INVOICE INFO -->
            <textField>
                <reportElement x="105" y="62" width="99" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Inv#: INV-" + $P{invoiceNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="105" y="68" width="99" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + $P{invoiceDate}.format(java.time.format.DateTimeFormatter.ofPattern("dd-MM-yyyy"))]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="105" y="74" width="99" height="6"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Time: " + ($P{invoiceTime} != null ? $P{invoiceTime} : "")]]></textFieldExpression>
            </textField>
        </band>
    </title>
