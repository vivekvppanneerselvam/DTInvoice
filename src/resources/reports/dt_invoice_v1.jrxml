            <textField isBlankWhenNull="true">
                <reportElement x="157" y="37" width="43" height="7" isRemoveLineWhenBlank="true">
                    <printWhenExpression><![CDATA[$P{discount} != null && $P{discount}.signum() > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="5"/>
                </textElement>
                <textFieldExpression><![CDATA["₹ " + com.dt.utils.IndianCurrencyFormatting.applyFormatting($P{discount})]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="106" y="45" width="50" height="7" isRemoveLineWhenBlank="true">
                    <printWhenExpression><![CDATA[$P{deliveryCharge} != null && $P{deliveryCharge}.signum() > 0]]></printWhenExpression>
                </reportElement>
