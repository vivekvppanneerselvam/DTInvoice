<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dt.controller.ModernInvoiceController"

            prefWidth="1900"
            prefHeight="1000"

            style="-fx-background-color: #f3f4f6;">

    <!-- ===================================================== -->
    <!-- MAIN -->
    <!-- ===================================================== -->

    <center>

        <HBox spacing="0">

            <!-- ================================================= -->
            <!-- LEFT + CENTER -->
            <!-- ================================================= -->

            <VBox HBox.hgrow="ALWAYS">

                <!-- ============================================= -->
                <!-- HEADER -->
                <!-- ============================================= -->

                <VBox spacing="10"

                      style="-fx-background-color: white;
                             -fx-padding: 10;
                             -fx-border-color: #d1d5db;
                             -fx-border-width: 0 0 1 0;">

                    <HBox alignment="CENTER_LEFT">

                        <!-- TITLE -->

                        <VBox spacing="2">

                            <Label text="Modern Invoice POS"

                                   style="-fx-font-size: 28px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: black;"/>

                            <HBox spacing="8"
                                  alignment="CENTER_LEFT">

                                <Label text="Invoice No :"

                                       style="-fx-font-size: 14px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #6b7280;"/>

                                <Label fx:id="lblInvoiceNumber"

                                       text="NEW"

                                       style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #2563eb;"/>

                                <Label fx:id="lblInvoiceMode"

                                       text="NEW"

                                       style="-fx-background-color: #16a34a;
                  -fx-text-fill: white;
                  -fx-padding: 3 10 3 10;
                  -fx-font-size: 11px;
                  -fx-font-weight: bold;"/>

                            </HBox>

                            <Label fx:id="lblDateTime"

                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #6b7280;"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- SALE TYPE -->

                        <VBox spacing="4">

                            <Label text="Sale Type"

                                   style="-fx-font-size: 11px;"/>

                            <HBox spacing="0">

                                <ToggleButton fx:id="btnCash"
                                              text="Cash"

                                              prefWidth="100"
                                              prefHeight="42"

                                              style="-fx-background-radius: 0;
                                                     -fx-border-radius: 0;"/>

                                <ToggleButton fx:id="btnCredit"
                                              text="Credit"

                                              prefWidth="100"
                                              prefHeight="42"

                                              style="-fx-background-radius: 0;
                                                     -fx-border-radius: 0;"/>

                                <ToggleButton fx:id="btnGST"
                                              text="GST"

                                              prefWidth="100"
                                              prefHeight="42"

                                              style="-fx-background-radius: 0;
                                                     -fx-border-radius: 0;"/>

                            </HBox>

                        </VBox>

                    </HBox>

                    <!-- SEARCH -->

                    <TextField fx:id="tfSearch"

                               promptText="Search products..."

                               prefHeight="42"

                               style="-fx-background-radius: 0;
                                      -fx-border-radius: 0;
                                      -fx-font-size: 13px;"/>

                </VBox>

                <!-- ============================================= -->
                <!-- BODY -->
                <!-- ============================================= -->

                <HBox spacing="0"
                      VBox.vgrow="ALWAYS">

                    <!-- ========================================= -->
                    <!-- LEFT PANEL -->
                    <!-- ========================================= -->

                    <VBox prefWidth="320"
                          minWidth="320"
                          maxWidth="320"

                          style="-fx-background-color: white;
                                 -fx-border-color: #d1d5db;
                                 -fx-border-width: 0 1 0 0;">

                        <!-- CUSTOMER -->

                        <VBox fx:id="customerSection"

                              spacing="8"

                              visible="false"
                              managed="false"

                              style="-fx-padding: 10;">

                            <Label text="Customer Details"

                                   style="-fx-font-size: 16px;
                                          -fx-font-weight: bold;"/>

                            <!-- SEARCH -->

                            <HBox spacing="5">

                                <TextField fx:id="tfCustomerSearch"

                                           promptText="GST / Phone / Company"

                                           HBox.hgrow="ALWAYS"

                                           prefHeight="36"

                                           style="-fx-background-radius: 0;
                                                  -fx-border-radius: 0;"/>

                                <Button text="Search"

                                        prefWidth="90"
                                        prefHeight="36"

                                        onAction="#onSearchCustomer"

                                        style="-fx-background-color: #e78f6b;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 0;
                                               -fx-border-radius: 0;"/>

                            </HBox>

                            <!-- NAME -->

                            <TextField fx:id="tfCustomerName"

                                       promptText="Customer / Company Name"

                                       prefHeight="36"

                                       style="-fx-background-radius: 0;
                                              -fx-border-radius: 0;"/>

                            <!-- PHONE -->

                            <TextField fx:id="tfCustomerPhone"

                                       promptText="Phone Number *"

                                       prefHeight="36"

                                       style="-fx-background-radius: 0;
                                              -fx-border-radius: 0;"/>

                            <!-- GST -->

                            <TextField fx:id="tfGSTNumber"

                                       promptText="GST Number *"

                                       prefHeight="36"

                                       style="-fx-background-radius: 0;
                                              -fx-border-radius: 0;"/>

                            <!-- ADDRESS -->

                            <TextArea fx:id="tfCustomerAddress"

                                      promptText="Address"

                                      prefHeight="90"

                                      style="-fx-background-radius: 0;
                                             -fx-border-radius: 0;"/>

                            <!-- BUTTON -->

                            <Button text="+ Add Customer"

                                    prefHeight="40"

                                    onAction="#onAddCustomer"

                                    style="-fx-background-color: #2563eb;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 0;
                                           -fx-border-radius: 0;"/>

                        </VBox>

                        <!-- CATEGORY -->

                        <VBox spacing="10"
                              VBox.vgrow="ALWAYS"

                              style="-fx-padding: 10;">

                            <Label text="Categories"

                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;"/>

                            <TreeView fx:id="categoriesTree"

                                      VBox.vgrow="ALWAYS"

                                      style="-fx-background-radius: 0;
                                             -fx-border-radius: 0;"/>

                        </VBox>

                    </VBox>

                    <!-- ========================================= -->
                    <!-- PRODUCTS -->
                    <!-- ========================================= -->

                    <ScrollPane fitToWidth="true"
                                HBox.hgrow="ALWAYS"

                                style="-fx-background-color: transparent;">

                        <content>

                            <FlowPane fx:id="itemsContainer"

                                      hgap="15"
                                      vgap="15"

                                      prefWrapLength="1000">

                                <padding>
                                    <Insets top="15"
                                            right="15"
                                            bottom="15"
                                            left="15"/>
                                </padding>

                            </FlowPane>

                        </content>

                    </ScrollPane>

                </HBox>

            </VBox>

            <!-- ================================================= -->
            <!-- RIGHT PANEL -->
            <!-- ================================================= -->

            <VBox prefWidth="450"
                  minWidth="450"
                  maxWidth="450"

                  style="-fx-background-color: white;
                         -fx-border-color: #d1d5db;
                         -fx-border-width: 0 0 0 1;">

                <!-- ============================================= -->
                <!-- CART HEADER -->
                <!-- ============================================= -->

                <HBox alignment="CENTER_LEFT"

                      style="-fx-padding: 10;">

                    <Label text="Cart Items"

                           style="-fx-font-size: 26px;
                                  -fx-font-weight: bold;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Refresh"

                            prefWidth="90"
                            prefHeight="40"

                            onAction="#onRefreshCart"

                            style="-fx-background-color: #2563eb;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 0;
                                   -fx-border-radius: 0;"/>

                </HBox>

                <!-- ============================================= -->
                <!-- TABLE -->
                <!-- ============================================= -->

                <TableView fx:id="cartTable"

                           VBox.vgrow="ALWAYS"

                           style="-fx-background-radius: 0;
                                  -fx-border-radius: 0;
                                  -fx-font-size: 12px;">

                    <columns>

                        <TableColumn fx:id="colItem"
                                     text="Item"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colQty"
                                     text="Qty"
                                     prefWidth="55"/>

                        <TableColumn fx:id="colPrice"
                                     text="Rate"
                                     prefWidth="70"/>

                        <TableColumn fx:id="colGST"
                                     text="GST %"
                                     prefWidth="70"/>

                        <TableColumn fx:id="colGSTAmount"
                                     text="GST"
                                     prefWidth="70"/>

                        <TableColumn fx:id="colTotal"
                                     text="Total"
                                     prefWidth="85"/>

                    </columns>

                </TableView>

                <!-- ============================================= -->
                <!-- BILL SUMMARY -->
                <!-- ============================================= -->

                <VBox spacing="10"

                      style="-fx-padding: 10;
                             -fx-border-color: #d1d5db;
                             -fx-border-width: 1 0 0 0;">

                    <!-- GRID -->

                    <GridPane hgap="10"
                              vgap="8">

                        <columnConstraints>

                            <ColumnConstraints hgrow="ALWAYS"/>

                            <ColumnConstraints prefWidth="160"/>

                        </columnConstraints>

                        <!-- DISCOUNT -->

                        <Label text="Discount"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="tfDiscount"

                                   promptText="0.00"

                                   style="-fx-background-radius: 0;
                                          -fx-border-radius: 0;"

                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="1"/>

                        <!-- DELIVERY -->

                        <Label text="Delivery"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="tfDeliveryCharge"

                                   promptText="0.00"

                                   style="-fx-background-radius: 0;
                                          -fx-border-radius: 0;"

                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <!-- SUBTOTAL -->

                        <Label text="Subtotal"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="lblSubtotal"

                               text="₹ 0.00"

                               style="-fx-font-weight: bold;"

                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                        <!-- GST -->

                        <Label text="GST"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="lblTax"

                               text="₹ 0.00"

                               style="-fx-font-weight: bold;"

                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>

                        <!-- PAID -->

                        <Label text="Paid"
                               GridPane.rowIndex="4"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="tfPaidAmount"

                                   promptText="0.00"

                                   style="-fx-background-radius: 0;
                                          -fx-border-radius: 0;"

                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="1"/>

                        <!-- BALANCE -->

                        <Label text="Balance"
                               GridPane.rowIndex="5"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="lblBalance"

                               text="₹ 0.00"

                               style="-fx-text-fill: red;
                                      -fx-font-weight: bold;"

                               GridPane.rowIndex="5"
                               GridPane.columnIndex="1"/>

                    </GridPane>

                    <!-- GRAND TOTAL -->

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Grand Total"

                               style="-fx-font-size: 24px;
                                      -fx-font-weight: bold;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="lblTotal"

                               text="₹ 0.00"

                               style="-fx-font-size: 36px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #2563eb;"/>

                    </HBox>

                    <!-- BUTTONS -->
                    <HBox spacing="10"
                          alignment="CENTER_LEFT">

                        <Label text="Payment Mode"/>

                        <ComboBox fx:id="cbPaymentMode"
                                  prefWidth="180"
                                  prefHeight="36"/>

                    </HBox>
                    <HBox spacing="10">

                        <Button text="Save"

                                prefHeight="45"

                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"

                                onAction="#onSaveInvoice"

                                style="-fx-background-color: #16a34a;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 0;
                                       -fx-border-radius: 0;"/>

                        <Button text="Save and Print"

                                prefHeight="45"

                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"

                                onAction="#onSaveAndPrint"

                                style="-fx-background-color: #2563eb;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 0;
                                       -fx-border-radius: 0;"/>

                    </HBox>

                </VBox>

            </VBox>

        </HBox>

    </center>

</BorderPane>