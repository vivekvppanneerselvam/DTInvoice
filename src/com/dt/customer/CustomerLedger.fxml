<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dt.customer.Controller"

            prefWidth="1400"
            prefHeight="850"

            style="-fx-background-color: #f3f4f6;">

    <!-- TOP -->

    <top>

        <VBox spacing="15"

              style="-fx-padding: 20;
                     -fx-background-color: white;">

            <!-- HEADER -->

            <HBox alignment="CENTER_LEFT"
                  spacing="15">

                <VBox spacing="5">

                    <Label fx:id="lblCustomerName"

                           text="Customer Ledger"

                           style="-fx-font-size: 26px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="lblPhone"

                           text="Phone"

                           style="-fx-text-fill: #6b7280;"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Print Ledger"

                        prefHeight="40"

                        onAction="#onPrint"

                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;"/>

            </HBox>

            <!-- SUMMARY -->

            <HBox spacing="20">

                <!-- TOTAL SALES -->

                <VBox spacing="8"

                      prefWidth="250"

                      style="-fx-background-color: white;
                             -fx-padding: 18;
                             -fx-background-radius: 18;
                             -fx-border-color: #e5e7eb;
                             -fx-border-radius: 18;">

                    <Label text="Total Sales"

                           style="-fx-text-fill: #6b7280;"/>

                    <Label fx:id="lblTotalSales"

                           text="₹ 0.00"

                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2563eb;"/>

                </VBox>

                <!-- RECEIVED -->

                <VBox spacing="8"

                      prefWidth="250"

                      style="-fx-background-color: white;
                             -fx-padding: 18;
                             -fx-background-radius: 18;
                             -fx-border-color: #e5e7eb;
                             -fx-border-radius: 18;">

                    <Label text="Total Received"

                           style="-fx-text-fill: #6b7280;"/>

                    <Label fx:id="lblTotalReceived"

                           text="₹ 0.00"

                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #16a34a;"/>

                </VBox>

                <!-- BALANCE -->

                <VBox spacing="8"

                      prefWidth="250"

                      style="-fx-background-color: white;
                             -fx-padding: 18;
                             -fx-background-radius: 18;
                             -fx-border-color: #e5e7eb;
                             -fx-border-radius: 18;">

                    <Label text="Outstanding"

                           style="-fx-text-fill: #6b7280;"/>

                    <Label fx:id="lblOutstanding"

                           text="₹ 0.00"

                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #dc2626;"/>

                </VBox>

            </HBox>

        </VBox>

    </top>

    <!-- CENTER -->

    <center>

        <VBox spacing="15"
              style="-fx-padding: 20;">

            <!-- FILTER -->

            <HBox spacing="10">

                <DatePicker fx:id="dpFrom"/>

                <DatePicker fx:id="dpTo"/>

                <Button text="Filter"
                        onAction="#onFilter"/>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="tfSearch"

                           promptText="Search Ref No / Remarks"

                           prefWidth="300"/>

            </HBox>

            <!-- TABLE -->

            <TableView fx:id="ledgerTable"

                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colDate"

                                 text="Date"

                                 prefWidth="160"/>

                    <TableColumn fx:id="colType"

                                 text="Type"

                                 prefWidth="140"/>

                    <TableColumn fx:id="colRef"

                                 text="Reference"

                                 prefWidth="160"/>

                    <TableColumn fx:id="colDebit"

                                 text="Debit"

                                 prefWidth="140"/>

                    <TableColumn fx:id="colCredit"

                                 text="Credit"

                                 prefWidth="140"/>

                    <TableColumn fx:id="colBalance"

                                 text="Balance"

                                 prefWidth="160"/>

                    <TableColumn fx:id="colRemarks"

                                 text="Remarks"

                                 prefWidth="350"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>