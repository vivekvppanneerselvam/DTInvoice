<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dt.customer.CustomerFormController"

            prefWidth="900"
            prefHeight="750"

            style="-fx-background-color: #f3f4f6;">

    <!-- TOP -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"

              style="-fx-padding: 20;
                     -fx-background-color: white;">

            <VBox spacing="5">

                <Label text="Customer Management"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;"/>

                <Label text="GST + Credit + Cash Customer Setup"
                       style="-fx-text-fill: #6b7280;"/>

            </VBox>

        </HBox>

    </top>

    <!-- CENTER -->

    <center>

        <ScrollPane fitToWidth="true">

            <content>

                <VBox spacing="20"
                      style="-fx-padding: 20;">

                    <!-- BASIC -->

                    <VBox spacing="15"

                          style="-fx-background-color: white;
                                 -fx-padding: 20;
                                 -fx-background-radius: 18;">

                        <Label text="Basic Details"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <GridPane hgap="15"
                                  vgap="15">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="30"/>

                                <ColumnConstraints percentWidth="70"/>

                            </columnConstraints>

                            <!-- TYPE -->

                            <Label text="Customer Type"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <HBox spacing="10"
                                  GridPane.rowIndex="0"
                                  GridPane.columnIndex="1">

                                <ToggleButton fx:id="btnCash"

                                              text="Cash"

                                              prefWidth="100"/>

                                <ToggleButton fx:id="btnCredit"

                                              text="Credit"

                                              prefWidth="100"/>

                                <ToggleButton fx:id="btnGST"

                                              text="GST"

                                              prefWidth="100"/>

                            </HBox>

                            <!-- CODE -->

                            <Label text="Customer Code"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfCustomerCode"

                                       editable="false"

                                       promptText="Auto Generated"

                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="1"/>

                            <!-- NAME -->

                            <Label text="Customer Name"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfCustomerName"

                                       promptText="Enter customer name"

                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="1"/>

                            <!-- PHONE -->

                            <Label text="Phone Number"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfPhone"

                                       promptText="Mobile Number"

                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="1"/>

                            <!-- ALT PHONE -->

                            <Label text="Alt Phone"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfAltPhone"

                                       promptText="Alternative Number"

                                       GridPane.rowIndex="4"
                                       GridPane.columnIndex="1"/>

                            <!-- EMAIL -->

                            <Label text="Email"
                                   GridPane.rowIndex="5"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfEmail"

                                       promptText="Email Address"

                                       GridPane.rowIndex="5"
                                       GridPane.columnIndex="1"/>

                        </GridPane>

                    </VBox>

                    <!-- GST -->

                    <VBox fx:id="gstSection"

                          spacing="15"

                          visible="false"
                          managed="false"

                          style="-fx-background-color: white;
                                 -fx-padding: 20;
                                 -fx-background-radius: 18;">

                        <Label text="GST Information"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <GridPane hgap="15"
                                  vgap="15">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="30"/>

                                <ColumnConstraints percentWidth="70"/>

                            </columnConstraints>

                            <!-- GST -->

                            <Label text="GST Number"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfGSTNumber"

                                       promptText="GST Number"

                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1"/>

                        </GridPane>

                    </VBox>

                    <!-- ADDRESS -->

                    <VBox spacing="15"

                          style="-fx-background-color: white;
                                 -fx-padding: 20;
                                 -fx-background-radius: 18;">

                        <Label text="Address Details"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <GridPane hgap="15"
                                  vgap="15">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="30"/>

                                <ColumnConstraints percentWidth="70"/>

                            </columnConstraints>

                            <!-- ADDRESS1 -->

                            <Label text="Address 1"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <TextArea fx:id="tfAddress1"

                                      prefHeight="80"

                                      promptText="Primary Address"

                                      GridPane.rowIndex="0"
                                      GridPane.columnIndex="1"/>

                            <!-- ADDRESS2 -->

                            <Label text="Address 2"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"/>

                            <TextArea fx:id="tfAddress2"

                                      prefHeight="80"

                                      promptText="Secondary Address"

                                      GridPane.rowIndex="1"
                                      GridPane.columnIndex="1"/>

                            <!-- CITY -->

                            <Label text="City"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfCity"

                                       promptText="City"

                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="1"/>

                            <!-- STATE -->

                            <Label text="State"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfState"

                                       promptText="State"

                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="1"/>

                            <!-- PIN -->

                            <Label text="Pincode"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfPincode"

                                       promptText="Pincode"

                                       GridPane.rowIndex="4"
                                       GridPane.columnIndex="1"/>

                        </GridPane>

                    </VBox>

                    <!-- BALANCE -->

                    <VBox fx:id="creditSection"

                          spacing="15"

                          visible="false"
                          managed="false"

                          style="-fx-background-color: white;
                                 -fx-padding: 20;
                                 -fx-background-radius: 18;">

                        <Label text="Credit Information"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <GridPane hgap="15"
                                  vgap="15">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="30"/>

                                <ColumnConstraints percentWidth="70"/>

                            </columnConstraints>

                            <!-- BALANCE -->

                            <Label text="Opening Balance"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="tfOpeningBalance"

                                       promptText="0"

                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1"/>

                            <!-- BAL TYPE -->

                            <Label text="Balance Type"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"/>

                            <ComboBox fx:id="cbBalanceType"

                                      prefWidth="200"

                                      GridPane.rowIndex="1"
                                      GridPane.columnIndex="1"/>

                        </GridPane>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <!-- BOTTOM -->

    <bottom>

        <HBox spacing="10"

              alignment="CENTER_RIGHT"

              style="-fx-padding: 20;
                     -fx-background-color: white;">

            <Button text="Cancel"

                    prefWidth="120"
                    prefHeight="45"

                    onAction="#onCancel"

                    style="-fx-background-color: #f3f4f6;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;"/>

            <Button text="Save Customer"

                    prefWidth="180"
                    prefHeight="45"

                    onAction="#onSave"

                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;"/>

        </HBox>

    </bottom>

</BorderPane>