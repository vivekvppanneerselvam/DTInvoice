<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dt.inventory.ModernItemsController"

            prefWidth="1850"
            prefHeight="980"

            style="-fx-background-color: #f3f4f6;">

    <center>

        <HBox spacing="0">

            <!-- ================================================= -->
            <!-- LEFT FORM -->
            <!-- ================================================= -->

            <VBox prefWidth="430"
                  minWidth="420"
                  maxWidth="450"

                  spacing="10"

                  style="-fx-background-color: white;
                         -fx-padding: 12;
                         -fx-border-color: #d1d5db;
                         -fx-border-width: 0 1 0 0;">

                <!-- TITLE -->

                <Label text="Inventory Details"

                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #111827;"/>

                <!-- ITEM CODE -->

                <VBox spacing="4">

                    <Label text="Item Code"

                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="tfItemCode"

                               prefHeight="34"

                               style="-fx-background-radius: 0;
                                      -fx-border-radius: 0;"/>

                </VBox>

                <!-- ITEM NAME -->

                <VBox spacing="4">

                    <Label text="Item Name"

                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="tfItemName"

                               prefHeight="34"

                               style="-fx-background-radius: 0;
                                      -fx-border-radius: 0;"/>

                </VBox>

                <!-- CATEGORY -->

                <HBox spacing="10">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Category"

                               style="-fx-font-size: 11px;
                                      -fx-font-weight: bold;"/>

                        <ComboBox fx:id="cbCategory"

                                  prefHeight="34"

                                  maxWidth="Infinity"

                                  style="-fx-background-radius: 0;
                                         -fx-border-radius: 0;"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Sub Category"

                               style="-fx-font-size: 11px;
                                      -fx-font-weight: bold;"/>

                        <ComboBox fx:id="cbSubCategory"

                                  prefHeight="34"

                                  maxWidth="Infinity"

                                  style="-fx-background-radius: 0;
                                         -fx-border-radius: 0;"/>

                    </VBox>

                </HBox>

                <!-- GST -->

                <HBox spacing="12"
                      alignment="CENTER_LEFT">

                    <CheckBox fx:id="chkGST"

                              text="GST Applicable"

                              style="-fx-font-weight: bold;"/>

                    <TextField fx:id="tfGST"

                               promptText="GST %"

                               prefWidth="120"

                               prefHeight="34"

                               style="-fx-background-radius: 0;
                                      -fx-border-radius: 0;"/>

                </HBox>

                <!-- IMAGE -->

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Button text="Upload Image"

                            onAction="#onUploadImage"

                            prefHeight="34"

                            style="-fx-background-color: #2563eb;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 0;
                                   -fx-border-radius: 0;"/>

                    <Label fx:id="lblImage"

                           text="No Image Selected"

                           style="-fx-text-fill: #6b7280;
                                  -fx-font-size: 11px;"/>

                </HBox>

                <!-- ================================================= -->
                <!-- MEASUREMENTS -->
                <!-- ================================================= -->

                <VBox spacing="6"
                      VBox.vgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Measurements"

                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="+ Add"

                                onAction="#onAddMeasurement"

                                style="-fx-background-color: #059669;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 0;
                                       -fx-border-radius: 0;"/>

                        <Button text="Delete"

                                onAction="#onDeleteMeasurement"

                                style="-fx-background-color: #dc2626;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 0;
                                       -fx-border-radius: 0;"/>

                    </HBox>

                    <!-- TABLE -->

                    <TableView fx:id="measurementTable"

                               VBox.vgrow="ALWAYS"

                               prefHeight="240"

                               style="-fx-background-radius: 0;
                                      -fx-border-radius: 0;">

                        <columns>

                            <TableColumn fx:id="colQty"
                                         text="Qty"
                                         prefWidth="70"/>

                            <TableColumn fx:id="colUnit"
                                         text="Unit"
                                         prefWidth="90"/>

                            <TableColumn fx:id="colSelling"
                                         text="Selling"
                                         prefWidth="90"/>

                            <TableColumn fx:id="colPurchase"
                                         text="Purchase"
                                         prefWidth="90"/>

                            <TableColumn fx:id="colStock"
                                         text="Stock"
                                         prefWidth="90"/>

                        </columns>

                    </TableView>

                </VBox>

                <!-- BUTTONS -->

                <GridPane hgap="10"
                          vgap="10">

                    <columnConstraints>

                        <ColumnConstraints hgrow="ALWAYS"/>

                        <ColumnConstraints hgrow="ALWAYS"/>

                    </columnConstraints>

                    <!-- SAVE -->

                    <Button text="Save Item"

                            maxWidth="Infinity"
                            prefHeight="42"

                            onAction="#onSave"

                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"

                            style="-fx-background-color: #2563eb;
                                   -fx-text-fill: white;
                                   -fx-font-size: 12px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 0;
                                   -fx-border-radius: 0;"/>

                    <!-- RESET -->

                    <Button text="Reset"

                            maxWidth="Infinity"
                            prefHeight="42"

                            onAction="#onReset"

                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"

                            style="-fx-background-color: #9333ea;
                                   -fx-text-fill: white;
                                   -fx-font-size: 12px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 0;
                                   -fx-border-radius: 0;"/>

                    <!-- DELETE -->

                    <Button text="Delete Item"

                            maxWidth="Infinity"
                            prefHeight="42"

                            onAction="#onDelete"

                            GridPane.rowIndex="1"
                            GridPane.columnSpan="2"

                            style="-fx-background-color: #dc2626;
                                   -fx-text-fill: white;
                                   -fx-font-size: 12px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 0;
                                   -fx-border-radius: 0;"/>

                </GridPane>

            </VBox>

            <!-- ================================================= -->
            <!-- RIGHT SECTION -->
            <!-- ================================================= -->

            <VBox HBox.hgrow="ALWAYS">

                <!-- HEADER -->

                <VBox spacing="8"

                      style="-fx-background-color: white;
                             -fx-padding: 12;
                             -fx-border-color: #d1d5db;
                             -fx-border-width: 0 0 1 0;">

                    <HBox alignment="CENTER_LEFT">

                        <!-- TITLE -->

                        <VBox spacing="2">

                            <Label text="Inventory Management"

                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #111827;"/>

                            <Label text="GST • Stock • Category • Measurements"

                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #6b7280;"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- CATEGORY FILTER -->

                        <ComboBox fx:id="cbFilterCategory"

                                  prefWidth="180"
                                  prefHeight="40"

                                  promptText="Category"

                                  style="-fx-background-radius: 0;
                                         -fx-border-radius: 0;"/>

                        <!-- SEARCH -->

                        <TextField fx:id="tfSearch"

                                   promptText="Search Item / Code"

                                   prefWidth="320"
                                   prefHeight="40"

                                   style="-fx-background-radius: 0;
                                          -fx-border-radius: 0;
                                          -fx-font-size: 13px;"/>

                        <!-- FILTER -->

                        <ComboBox fx:id="cbFilter"

                                  prefWidth="170"
                                  prefHeight="40"

                                  style="-fx-background-radius: 0;
                                         -fx-border-radius: 0;"/>

                    </HBox>

                </VBox>

                <!-- TABLE -->

                <!-- ================================================= -->
                <!-- CENTER CONTENT -->
                <!-- ================================================= -->

                <SplitPane dividerPositions="0.26"

                           VBox.vgrow="ALWAYS">

                    <!-- ============================================= -->
                    <!-- CATEGORY PANEL -->
                    <!-- ============================================= -->

                    <VBox spacing="10"

                          style="-fx-background-color: white;
                 -fx-padding: 10;
                 -fx-border-color: #d1d5db;
                 -fx-border-width: 0 1 0 0;">

                        <!-- TITLE -->

                        <HBox alignment="CENTER_LEFT">

                            <Label text="Categories"

                                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="+"

                                    onAction="#onAddCategory"

                                    prefWidth="32"

                                    style="-fx-background-color: #059669;
                           -fx-text-fill: white;
                           -fx-background-radius: 0;"/>

                        </HBox>

                        <!-- TREE -->

                        <TreeView fx:id="categoryTree"

                                  VBox.vgrow="ALWAYS"/>

                        <!-- SUB CATEGORY -->

                        <VBox spacing="6">

                            <Label text="Sub Category"

                                   style="-fx-font-size: 13px;
                          -fx-font-weight: bold;"/>

                            <TextField fx:id="tfSubCategory"

                                       promptText="Sub Category Name"

                                       prefHeight="34"

                                       style="-fx-background-radius: 0;
                              -fx-border-radius: 0;"/>

                            <HBox spacing="6">

                                <Button text="Add"

                                        onAction="#onAddSubCategory"

                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"

                                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-background-radius: 0;"/>

                                <Button text="Update"

                                        onAction="#onUpdateSubCategory"

                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"

                                        style="-fx-background-color: #9333ea;
                               -fx-text-fill: white;
                               -fx-background-radius: 0;"/>

                                <Button text="Delete"

                                        onAction="#onDeleteSubCategory"

                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"

                                        style="-fx-background-color: #dc2626;
                               -fx-text-fill: white;
                               -fx-background-radius: 0;"/>

                            </HBox>

                        </VBox>

                    </VBox>

                    <!-- ============================================= -->
                    <!-- ITEM TABLE -->
                    <!-- ============================================= -->

                    <VBox spacing="10"

                          VBox.vgrow="ALWAYS"

                          style="-fx-padding: 12;">

                        <HBox alignment="CENTER_LEFT">

                            <Label text="Inventory List"

                                   style="-fx-font-size: 22px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #111827;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Select Row → Edit Item"

                                   style="-fx-font-size: 11px;
                          -fx-text-fill: #6b7280;"/>

                        </HBox>

                        <!-- ITEM TABLE -->

                        <TableView fx:id="itemTable"

                                   VBox.vgrow="ALWAYS"

                                   style="-fx-background-radius: 0;
                          -fx-border-radius: 0;
                          -fx-font-size: 13px;">

                            <columns>

                                <TableColumn fx:id="colCodeMain"
                                             text="Item Code"
                                             prefWidth="160"/>

                                <TableColumn fx:id="colNameMain"
                                             text="Item Name"
                                             prefWidth="260"/>

                                <TableColumn fx:id="colCategoryMain"
                                             text="Category"
                                             prefWidth="180"/>

                                <TableColumn fx:id="colSubCategoryMain"
                                             text="Sub Category"
                                             prefWidth="180"/>

                                <TableColumn fx:id="colGSTMain"
                                             text="GST %"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colPriceMain"
                                             text="Selling Price"
                                             prefWidth="140"/>

                                <TableColumn fx:id="colStockMain"
                                             text="Stock"
                                             prefWidth="120"/>

                                <TableColumn fx:id="colStatusMain"
                                             text="Status"
                                             prefWidth="140"/>

                            </columns>

                        </TableView>

                    </VBox>

                </SplitPane>

            </VBox>

        </HBox>

    </center>

</BorderPane>