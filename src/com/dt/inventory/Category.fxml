<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dt.inventory.CategoryController"

            prefWidth="1500"
            prefHeight="850"

            style="-fx-background-color: #f3f4f6;">

    <!-- TOP -->

    <top>

        <VBox spacing="15"
              style="-fx-padding: 20;">

            <Label text="Category Management"
                   style="-fx-font-size: 24px;
        -fx-font-weight: bold;"/>

            <HBox spacing="10">

                <TextField fx:id="tfSearch"
                           promptText="Search category..."
                           HBox.hgrow="ALWAYS"
                           prefHeight="40"/>

                <Button text="Add Category"
                        prefHeight="40"
                        onAction="#onAddCategory"/>

            </HBox>

        </VBox>

    </top>

    <!-- CENTER -->

    <center>

        <ScrollPane fitToWidth="true">

            <content>

                <FlowPane fx:id="categoryContainer"

                          hgap="20"
                          vgap="20"

                          prefWrapLength="1200"

                          style="-fx-padding: 20;"/>

            </content>

        </ScrollPane>

    </center>

</BorderPane>